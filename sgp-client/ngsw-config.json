{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": { "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"] }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": { "files": ["/assets/**", "/icons/**", "/i18n/**"] }
    }
  ],
  "dataGroups": [
    {
      "name": "reference-data",
      "urls": ["/api/v1/puentes/publico/**", "/api/v1/formularios/activo/**"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 50, "maxAge": "6h", "timeout": "4s" }
    }
  ]
}
